NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# 使用 growth_app 运行账号；密码有特殊字符时须进行 URL 编码。
# 不要使用 root 或 growth_migrator。
MYSQL_URL=mysql://growth_app:replace-me@127.0.0.1:3306/growth_diary

# 微信登录凭据只放在服务端，必须成对配置；production 必填。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 60–604800 秒，默认 7 天；开发会话最多 1 小时。
AUTH_SESSION_TTL_SECONDS=604800
# 本地联调可开启；production 禁止。密钥使用随机 32 字节的 hex 字符串。
ENABLE_DEV_LOGIN=false
DEV_LOGIN_KEY=
# 邀请码 HMAC 专用随机密钥，与开发登录密钥分开；production 必填。
INVITE_CODE_SECRET=

# 阶段5：未配置时保持false；开启前需私有COS桶及数据万象图片/媒体处理。
MEDIA_ENABLED=false
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# Computer export pairing; HTTPS origin only, no trailing slash. Leave blank to disable pairing.
EXPORT_PUBLIC_ORIGIN=

# Stage 7: real operator details and verified retention/backup policy required before enabling.
GOVERNANCE_ENABLED=false
LEGAL_OPERATOR=daft
LEGAL_CONTACT=daft138@gmail.com
LEGAL_RETENTION_NOTE=
