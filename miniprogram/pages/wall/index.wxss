.wall-page {
  padding-bottom: 150rpx;
}

.wall-context-bar {
  display: flex;
  align-items: center;
  margin: -28rpx -28rpx 0;
  padding: 20rpx 34rpx;
  border-bottom: 1rpx solid #efe4dc;
  background: rgba(255, 253, 249, .96);
}

.context-home {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: #edf5ee;
  color: #66806b;
  font-size: 30rpx;
}

.context-copy { display: flex; flex: 1; flex-direction: column; gap: 3rpx; }
.context-label { color: #9a8b81; font-size: 19rpx; }
.context-value { color: #4e433d; font-size: 26rpx; font-weight: 700; }
.context-action { color: #bd6d54; font-size: 22rpx; font-weight: 600; }

.hero {
  display: flex;
  justify-content: space-between;
  min-height: 230rpx;
  margin: 0 -28rpx 28rpx;
  padding: 50rpx 42rpx 36rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #fff2e6 0%, #f9d8cc 100%);
}

.hero-copy {
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  margin-bottom: 18rpx;
  color: #b66d55;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.hero-title {
  color: #503b32;
  font-family: serif;
  font-size: 45rpx;
  font-weight: 700;
  line-height: 1.42;
}

.title-break { display: block; }

.hero-sun {
  width: 116rpx;
  height: 116rpx;
  margin-top: 15rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  color: #e79b68;
  font-size: 62rpx;
  line-height: 116rpx;
  text-align: center;
}

.child-filter {
  width: 100%;
  margin: 26rpx 0 34rpx;
}

.timeline {
  position: relative;
  padding-left: 32rpx;
}

.year-group { margin-bottom: 24rpx; }
.year-filter { display: flex; align-items: center; justify-content: space-between; margin: 0 0 24rpx 32rpx; color: #8d6855; font-size: 26rpx; }
.year-picker { min-width: 200rpx; display: flex; justify-content: space-between; gap: 24rpx; padding: 16rpx 24rpx; border-radius: 16rpx; background: #fff1e8; }
.archive-heading { display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 0; text-align: left; line-height: 1.5; }
.archive-heading::after, .load-more-button::after { border: 0; }
.year-content { padding: 0; }
/* 显式覆盖微信 button 默认宽度和居中边距，让年月从卡片左边缘开始。 */
button.archive-heading.month-heading { width: calc(100% - 32rpx); box-sizing: border-box; margin: 0 0 0 32rpx; padding: 20rpx 0; border-radius: 16rpx; background: #fff8f2; color: #8d6855; font-size: 28rpx; }
.record-time { padding: 20rpx 24rpx 0; color: #8d6855; font-size: 24rpx; }
.month-group { margin-bottom: 16rpx; }
.month-group .timeline { margin-top: 22rpx; }
.archive-arrow { display: inline-block; font-size: 38rpx; line-height: 1; transition: transform .2s ease; }
.archive-arrow.expanded { transform: rotate(90deg); }
.load-more-button { margin: 20rpx auto; background: #fff1e8; color: #a36e55; font-size: 26rpx; border-radius: 18rpx; }

.timeline::before {
  position: absolute;
  top: 18rpx;
  bottom: 50rpx;
  left: 11rpx;
  width: 2rpx;
  background: #ead9ce;
  content: "";
}

.timeline-item {
  position: relative;
  margin-bottom: 30rpx;
}

.timeline-dot {
  position: absolute;
  top: 34rpx;
  left: -29rpx;
  z-index: 2;
  width: 17rpx;
  height: 17rpx;
  border: 6rpx solid var(--cream);
  border-radius: 50%;
}

.timeline-card {
  overflow: hidden;
}

.card-head {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 20rpx;
}

.child-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.card-head-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.child-name {
  margin-right: 12rpx;
  font-weight: 700;
}

.age-label {
  color: var(--muted);
  font-size: 23rpx;
}

.kind-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1eb;
  color: #c97960;
  font-size: 21rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
  max-height: 420rpx;
  overflow: hidden;
}

.media-count-1 {
  grid-template-columns: 1fr;
}

.media-cell {
  position: relative;
  min-height: 210rpx;
  overflow: hidden;
}

.media-count-1 .media-cell {
  min-height: 390rpx;
}

.tone-peach { background: linear-gradient(145deg, #f8c7b7, #f2a78f); }
.tone-sage { background: linear-gradient(145deg, #c6d7c1, #88aa91); }
.tone-rose { background: linear-gradient(145deg, #efd0d7, #d996a5); }

.media-image {
  width: 100%;
  height: 100%;
  min-height: inherit;
}

.media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 100%;
  min-height: inherit;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.media-icon {
  margin-bottom: 10rpx;
  font-size: 52rpx;
}

.video-tag {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(35, 31, 28, 0.62);
  color: #fff;
  font-size: 20rpx;
}

.card-body {
  padding: 24rpx;
}

.title-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 700;
}

.metric-chip {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #eef6ee;
  color: #61826a;
  font-size: 22rpx;
  font-weight: 600;
}

.entry-body {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #6c625b;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.event-label { color: #c17472; font-size: 23rpx; }
.open-label { margin-left: auto; color: #b08a78; font-size: 23rpx; }
.load-more { padding: 30rpx; color: var(--muted); font-size: 23rpx; text-align: center; }

.floating-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  z-index: 5;
  padding: 22rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ed9172, #db7564);
  box-shadow: 0 14rpx 30rpx rgba(202, 100, 77, 0.3);
  color: #fff;
  font-weight: 600;
}
