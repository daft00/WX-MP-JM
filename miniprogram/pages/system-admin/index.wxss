.admin-page { min-height: 100vh; padding: 0 28rpx 70rpx; background: #f7f3ee; }
.admin-hero { display: flex; flex-direction: column; margin: 0 -28rpx 26rpx; padding: 48rpx 32rpx 42rpx; background: #443a34; color: #fffaf4; }
.admin-kicker { color: #eeb29f; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.admin-title { margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }
.admin-subtitle { margin-top: 12rpx; color: #d8cdc6; font-size: 24rpx; }
.privacy-banner { padding: 20rpx 22rpx; border-radius: 20rpx; background: #fff0e9; color: #985843; font-size: 22rpx; line-height: 1.6; }
.stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin: 24rpx 0 34rpx; }
.stat-card { display: flex; align-items: center; flex-direction: column; padding: 20rpx 4rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(72,54,43,.05); }
.stat-card text:first-child { color: #c96f54; font-size: 34rpx; font-weight: 700; }
.stat-card text:last-child { margin-top: 4rpx; color: #94867d; font-size: 24rpx; }

.status-card { margin: 24rpx 0; padding: 24rpx; border-radius: 18rpx; background: #fff; line-height: 1.6; }
.stats-note { display: block; margin-bottom: 20rpx; color: #76695f; font-size: 24rpx; line-height: 1.6; }
.stat-card text:first-child { overflow-wrap: anywhere; }
.admin-page button { margin-top: 20rpx; }

.list-tabs, .pagination { display: flex; align-items: center; gap: 16rpx; }
.list-tabs button, .pagination button { flex: 1; font-size: 26rpx; }
.pagination text { padding-top: 20rpx; font-size: 24rpx; }
.list-card { margin-top: 20rpx; padding: 24rpx; background: #fff; border-radius: 18rpx; overflow-wrap: anywhere; }
.list-card text { display: block; line-height: 1.6; }
.list-name { font-size: 30rpx; font-weight: 600; }
.list-detail, .list-id { margin-top: 10rpx; color: #76695f; font-size: 24rpx; }

.audit-input { margin: 18rpx 0; padding: 20rpx; border: 1rpx solid #d8cdc6; border-radius: 12rpx; font-size: 26rpx; }
