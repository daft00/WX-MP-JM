<view class="page export-page">
  <view class="export-hero"><text class="export-title">导出成长记录</text></view>
  <view>按月、季度或年度导出保存的媒体版本（可能已压缩）。每包最多100MiB，各含离线HTML，结果保留24小时；请下载全部分包后解压查看。</view>
  <view wx:if="{{!isAdmin}}">仅家庭所有者和管理员可创建、下载导出。</view>
  <view wx:if="{{isAdmin}}" class="create-card card">
    <picker disabled="{{busy}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild"><view>宝宝：{{children[childIndex].name || '暂无宝宝'}}</view></picker>
    <picker disabled="{{busy}}" range="{{periodTypes}}" value="{{periodIndex}}" bindchange="changePeriod"><view>{{periodTypes[periodIndex]}}</view></picker>
    <picker wx:if="{{periodIndex === 0}}" disabled="{{busy}}" mode="date" fields="month" value="{{selectedMonth}}" bindchange="changeMonth"><view>{{selectedMonth}}</view></picker>
    <picker wx:else disabled="{{busy}}" mode="date" fields="year" value="{{selectedYear}}" bindchange="changeYear"><view>{{selectedYear}}年</view></picker>
    <picker wx:if="{{periodIndex === 1}}" disabled="{{busy}}" range="{{quarters}}" value="{{quarterIndex}}" bindchange="changeQuarter"><view>{{quarters[quarterIndex]}}</view></picker>
    <button disabled="{{busy}}" bindtap="createExport">创建后台导出任务</button>
    <button disabled="{{busy}}" bindtap="loadData">刷新进度</button>
    <button bindtap="copyComputerUrl">复制电脑下载页地址</button>
    <button disabled="{{busy}}" bindtap="authorizeComputer">扫码授权电脑</button>
  </view>
  <view wx:if="{{error}}">{{error}}</view>
  <view wx:for="{{jobs}}" wx:key="id" wx:for-item="job" class="card">
    <view>{{job.yearMonth}} · {{job.status}} · {{job.progress}}/{{job.partCount}}包</view>
    <view wx:if="{{job.error}}">{{job.error}}；内容已变化时请清理后重建任务。</view>
    <view wx:if="{{job.expiresAt}}">到期时间：{{job.expiresAt}}</view>
    <block wx:if="{{job.status === 'READY'}}">
      <button wx:for="{{job.parts}}" wx:key="number" disabled="{{busy}}" data-id="{{job.id}}" data-part="{{item.number}}" bindtap="shareArchive">下载并分享第{{item.number}}包</button>
      <button disabled="{{busy}}" data-id="{{job.id}}" bindtap="confirmBackup">{{job.confirmedAt ? '已人工确认备份' : '人工确认全部已备份'}}</button>
    </block>
    <button disabled="{{busy}}" data-id="{{job.id}}" bindtap="deleteArchive">取消 / 清理导出包</button>
  </view>
</view>
