.detail-page { padding-bottom: 70rpx; }
.detail-head { display: flex; align-items: center; padding: 16rpx 8rpx 28rpx; }
.detail-avatar { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 18rpx; border-radius: 50%; color: #fff; font-weight: 700; }
.detail-head-copy { display: flex; flex-direction: column; gap: 6rpx; }
.detail-child { font-size: 31rpx; font-weight: 700; }
.detail-content { display: flex; flex-direction: column; padding: 34rpx; }
.detail-kind { margin-bottom: 14rpx; color: #c1755c; font-size: 23rpx; font-weight: 600; letter-spacing: 2rpx; }
.detail-title { font-family: serif; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.detail-body { margin-top: 26rpx; color: #625750; font-size: 30rpx; line-height: 1.85; white-space: pre-wrap; }
.metric-panel, .event-panel { margin-top: 22rpx; padding: 18rpx 22rpx; border-radius: 18rpx; font-weight: 600; }
.metric-panel { background: #eff6ef; color: #5f7e67; }
.event-panel { background: #fff0ee; color: #b86c69; }
.detail-media { margin-top: 26rpx; }
.detail-media-item { margin-bottom: 18rpx; overflow: hidden; border-radius: 26rpx; }
.detail-media-item image, .detail-media-item video { display: block; width: 100%; }
.detail-placeholder { display: flex; align-items: center; justify-content: center; flex-direction: column; min-height: 420rpx; color: #fff; }
.placeholder-icon { margin-bottom: 14rpx; font-size: 68rpx; }
.placeholder-note { margin-top: 8rpx; color: rgba(255, 255, 255, 0.76); font-size: 22rpx; }
.tone-peach { background: linear-gradient(145deg, #f8c7b7, #f2a78f); }
.tone-sage { background: linear-gradient(145deg, #c6d7c1, #88aa91); }
.tone-rose { background: linear-gradient(145deg, #efd0d7, #d996a5); }
.action-row { display: flex; gap: 18rpx; margin-top: 36rpx; }
.action-button { flex: 1; margin: 0; }
