[Unit]
Description=Growth Diary export generation and cleanup
After=network.target mysql.service growth-diary.service
PartOf=growth-diary.service

[Service]
Type=oneshot
User=growth-api
Group=growth-api
WorkingDirectory=/opt/growth-diary/current
EnvironmentFile=/etc/growth-diary/app.env
ExecStart=/usr/bin/node --max-old-space-size=192 dist/exports/worker.js
TimeoutStartSec=35min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
